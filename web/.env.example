# Password for the web UI login page
ELASTICCLAW_UI_TOKEN=change-me

# Your hub URL (server-side only — never exposed to the browser)
ELASTICCLAW_HUB_URL=http://localhost:18788

# Your hub user token (server-side, used in production)
ELASTICCLAW_HUB_TOKEN=your-hub-token

# Dev only: expose hub token to browser so /api/hub-config cookie round-trip is skipped
# Set to the same value as ELASTICCLAW_HUB_TOKEN when running npm run dev
NEXT_PUBLIC_HUB_TOKEN=your-hub-token
