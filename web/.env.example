# Password for the web UI login page
ELASTICCLAW_UI_TOKEN=change-me

# Hub URL — exposed to browser so login can POST directly (not secret, just a server address)
# In production this is the same origin, leave unset
# In dev set to your hub address
NEXT_PUBLIC_HUB_URL=http://localhost:8080

# Your hub user token (used server-side for hub-config proxy)
ELASTICCLAW_HUB_TOKEN=your-hub-token
